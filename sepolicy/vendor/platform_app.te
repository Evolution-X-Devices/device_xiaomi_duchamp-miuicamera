# MIUI Camera
typeattribute platform_app hal_graphics_allocator_client;
typeattribute platform_app vendor_hal_citsensorservice_xiaomi_client;

binder_use(platform_app)
binder_call(platform_app, mtk_hal_camera)

binder_call(platform_app, hal_misys_vendor)
binder_call(hal_misys_vendor, platform_app)
binder_call(platform_app_36, hal_misys_vendor)
binder_call(hal_misys_vendor, platform_app_36)

allow platform_app vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app vendor_camera_data_file:file { getattr open read };

allow platform_app app_data_file:file execute;

# MIUI Camera
typeattribute platform_app hal_camera_client;
typeattribute platform_app hal_graphics_allocator_client;
typeattribute platform_app vendor_hal_citsensorservice_xiaomi_client;

# Allow platform_app to read vendor camera properties
get_prop(platform_app, vendor_mtk_camera_prop)
get_prop(platform_app, vendor_camera_sensor_prop)
get_prop(platform_app, vendor_display_type_prop)
get_prop(platform_app, vendor_us_proximity_prop)

typeattribute platform_app_36 hal_graphics_allocator_client;
typeattribute platform_app_36 vendor_hal_citsensorservice_xiaomi_client;
allow platform_app mtk_hal_bgs_hwservice:hwservice_manager find;

binder_use(platform_app_36)
binder_call(platform_app_36, mtk_hal_camera)

allow platform_app_36 vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app_36 vendor_camera_data_file:file { getattr open read };

allow platform_app_36 app_data_file:file execute;

# MIUI Camera
typeattribute platform_app_36 hal_camera_client;
typeattribute platform_app_36 hal_graphics_allocator_client;
typeattribute platform_app_36 vendor_hal_citsensorservice_xiaomi_client;

# Allow platform_app_36 to read vendor camera properties
get_prop(platform_app_36, vendor_mtk_camera_prop)
get_prop(platform_app_36, vendor_camera_sensor_prop)
get_prop(platform_app_36, vendor_display_type_prop)
get_prop(platform_app_36, vendor_us_proximity_prop)

allow platform_app proc_pressure_mem:file r_file_perms;
allow platform_app proc_pressure_cpu:file r_file_perms;
allow platform_app proc_pressure_io:file r_file_perms;
allow platform_app_36 proc_pressure_mem:file r_file_perms;
allow platform_app_36 proc_pressure_cpu:file r_file_perms;
allow platform_app_36 proc_pressure_io:file r_file_perms;

allow platform_app_36 sysfs_therm:dir search;
allow platform_app_36 sysfs_therm:file r_file_perms;

allow platform_app_36 unlabeled:filesystem getattr;